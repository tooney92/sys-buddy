# OS
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# Logs
*.log

# Environment
.env
.env.local
.env.*.local

# Dependencies / build (add stack-specific entries as the project grows)
node_modules/
dist/
build/

# Claude Code — local per-user settings (approvals, allowlist). .mcp.json IS tracked.
.claude/settings.local.json

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# sys-buddy runtime database
*.db
*.db-wal
*.db-shm

# Playwright MCP scratch output (screenshots/snapshots from browser-driven checks)
.playwright-mcp/

# Personal/private — never committed
tutorial/
enterprise/
ideas/
demo/
# Machine-local: a personal permission allowlist plus agent worktrees and scratch.
# NOTE the `/*`: git does not descend into an ignored DIRECTORY, so `.claude/` followed
# by a negation would silently do nothing. Ignoring the CONTENTS lets the negation below
# actually apply.
.claude/*
# ...except skills. A skill is a procedure the whole team (and every agent) should get —
# same reason docs/release-playbook.md is tracked. Machine-local would mean the person
# who wrote it is the only one who benefits.
!.claude/skills/
